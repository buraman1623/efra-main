# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build links back to the admin panel inside Telegram notifications
# (e.g. https://efrabusinessgroup.com). Leave blank in local dev if you don't
# want links included.
NEXT_PUBLIC_SITE_URL=

# Telegram bot notifications — sent whenever a new contact message or quote
# request is submitted. See the setup guide for how to create the bot and
# find your chat ID.
TELEGRAM_BOT_TOKEN=
# Comma-separated if you want more than one admin notified, e.g. "111,222"
TELEGRAM_ADMIN_CHAT_IDS=
